{
  "name": "jtv-concierge-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host localhost --port 5173 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "snapshot": "tsx server/snapshot.ts"
  },
  "dependencies": {
    "algoliasearch": "5.59.0",
    "instantsearch.css": "^8.5.1",
    "instantsearch.js": "4.119.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-instantsearch": "7.51.0",
    "react-instantsearch-core": "7.51.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
