{
  "name": "jtv-concierge-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host localhost --port 5173 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "format:check": "prettier --check server shared src tests scripts *.config.* *.json --ignore-path .prettierignore && npm run check:line-policy",
    "lint": "eslint . --max-warnings=0",
    "check:dependencies": "dependency-cruiser --validate .dependency-cruiser.cjs server shared src tests",
    "check:line-policy": "node scripts/check-line-policy.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && npm run check:server && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "snapshot": "tsx server/snapshot.ts",
    "check:server": "node scripts/check-server-runtime.mjs"
  },
  "dependencies": {
    "instantsearch.css": "^8.5.1",
    "instantsearch.js": "4.119.0",
    "lucide-react": "^0.468.0",
    "markdown-to-jsx": "^7.7.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-instantsearch": "7.51.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
