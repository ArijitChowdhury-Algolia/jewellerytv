# Server-side only. Supply values through the hosting provider's environment settings.
# Local development currently reads the parent project's .env.local.
ALGOLIA_APP_ID=your_algolia_application_id
ALGOLIA_SEARCH_API_KEY=your_server_side_algolia_key

# Hosted exact-domain allowlist (no wildcard).
APP_ALLOWED_HOSTS=jewellerytv.vercel.app
# Enable only after connecting and validating the dedicated published interpreter.
BRIEF_V2_ENABLED=false
# JTV_BRIEF_AGENT_ID=your_brief_extractor_agent_id
# Optional isolated concierge candidate for testing. Omit to use the main agent.
# JTV_CONCIERGE_AGENT_ID=your_published_candidate_id
