# Server-side configuration. Keep real values in the project-root .env.local locally
# or in the protected Vercel project's environment. Never put keys in VITE_* variables.
ALGOLIA_APP_ID=your_algolia_application_id
ALGOLIA_SEARCH_API_KEY=your_search_only_algolia_key

# Exact hosted domain allowlist, no wildcard.
APP_ALLOWED_HOSTS=jewellerytv.vercel.app

# Local development uses the development ID. Production uses the production ID.
# Both may name the same published Concierge. The UI does not gate on environment.
JTV_CONCIERGE_DEVELOPMENT_AGENT_ID=your_published_development_agent_id
JTV_CONCIERGE_PRODUCTION_AGENT_ID=your_published_hosted_agent_id
